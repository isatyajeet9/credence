# Copy this file to .env and fill in real values. Never commit .env itself.

# local postgres install, default superuser/password from setup
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/credence

# Random long string used to sign JWTs. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-secret

# JWT settings
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Razorpay - test mode. Get real test keys from https://dashboard.razorpay.com (test mode toggle, top left)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=test_webhook_secret_for_local_dev_only

# Resend - transactional email (OTP verification, password reset). Free at
# https://resend.com - sign up, create an API key. Leave blank to skip
# sending and just log the OTP code to the console instead.
RESEND_API_KEY=

# Google Sign-In - OAuth Client ID from Google Cloud Console (Credentials ->
# Create OAuth client ID -> Web application). Must match the ID used in
# frontend/.env.local's NEXT_PUBLIC_GOOGLE_CLIENT_ID. Leave blank to hide
# the Google button and disable /auth/google.
GOOGLE_CLIENT_ID=
